# Development-only Copilot bridge configuration. Never store real tokens here.
# Authentication happens inside Microsoft's own signed-in Edge/WebView session.
COPILOT_URL=
TORGY_COPILOT_PROFILE=
COPILOT_TIMEOUT_MS=90000

# Optional DOM overrides for the Playwright diagnostic script only.
# Leave blank unless Microsoft's UI on your tenant needs an explicit selector.
COPILOT_INPUT_SELECTOR=
COPILOT_SEND_SELECTOR=
COPILOT_RESPONSE_SELECTOR=
