{
  "name": "torgy-local",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles nsis && cargo build --manifest-path src-tauri/Cargo.toml --release --bin torgy-machine-agent && node scripts/build-machine-agent-installer.mjs",
    "machine-agent:bundle": "node scripts/build-machine-agent-installer.mjs",
    "copilot:poc": "tsx scripts/copilot-poc.ts",
    "core:check": "tsc -p tsconfig.core.json",
    "security:repo": "node scripts/repo-safety-check.mjs",
    "configure:deployment": "node scripts/configure-deployment.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "web:install": "npm --prefix apps/web-codex ci",
    "web:dev": "npm --prefix apps/web-codex run dev",
    "web:build": "npm --prefix apps/web-codex run build",
    "web:test": "npm --prefix apps/web-codex run test",
    "web:typecheck": "npm --prefix apps/web-codex run typecheck",
    "release:windows-update": "powershell -ExecutionPolicy Bypass -File scripts/release-windows-update.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "lucide-react": "1.43.0",
    "react": "19.3.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
